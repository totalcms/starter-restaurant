{#
	Shown for any address that doesn't match a page.
#}
{% extends 'layouts/default.twig' %}

{% block content %}
	<section class="center" data-max="lg">
		<div class="bill-masthead" data-size="page">
			<h1>We couldn't find that page</h1>
			<p class="lede">It may have moved, or the link may have a typo.</p>
			<div class="cluster" data-justify="center" data-gap="sm">
				<a class="button" href="{{ cms.builder.url('home') }}">Home</a>
				<a class="button bill-flip" href="{{ cms.builder.url('menu') }}" data-emphasis="medium">See the menu</a>
			</div>
		</div>
	</section>
{% endblock %}
