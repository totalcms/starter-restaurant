{#
	The site's top bar. Links come from Site Builder: every page with
	"Show in navigation" turned on appears here, in the order set in the admin.

	Yeti's nav needs no JavaScript. On a narrow screen the links fold behind the
	menu button, which opens them with the browser's built-in popover.
#}
<nav class="nav" aria-label="Site" data-threshold="lg" data-sticky>
	<a href="{{ cms.builder.url('home') }}" data-brand>{% include 'partials/logo.twig' %}<span>{{ info.name }}</span></a>

	<button type="button" popovertarget="site-menu" aria-label="Menu">
		<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2 4h12M2 8h12M2 12h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
	</button>

	<ul id="site-menu" popover role="list">
		{# The close button, shown only while the menu is open on a phone. #}
		<li data-close><button type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label="Close"><svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></li>
		{% for item in cms.builder.nav() %}
			{# aria-current marks the page you're on; Yeti highlights it. #}
			<li><a href="{{ item.route }}"{% if page.id|default('') == item.id %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
		{% endfor %}
	</ul>

	{# Shown only when a reservation link is filled in under Restaurant Info. #}
	{% if info.reservationUrl %}
		<div data-actions><a class="button" href="{{ info.reservationUrl }}" data-size="sm">Book a table</a></div>
	{% endif %}
</nav>
